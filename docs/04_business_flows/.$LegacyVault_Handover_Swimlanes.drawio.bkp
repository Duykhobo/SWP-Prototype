        <mxCell id="title_c" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontFamily=Arial;fontStyle=1;fillColor=#1E3A8A;fontColor=#FFFFFF;strokeColor=#0F172A;" value="TAB C · CƠ CHẾ RESCUE HOLD KHẨN CẤP, RETRY IDEMPOTENCY &amp;amp; QUẢN LÝ VÒNG ĐỜI PHÒNG LIVEKIT">
          <mxGeometry x="50" y="20" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="desc_c" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=1;fontSize=11;fontFamily=Arial;fillColor=#F8FAFC;fontColor=#334155;strokeColor=#CBD5E1;spacingLeft=15;" value="Bao phủ 3 cơ chế an toàn trọng yếu: (1) Emergency Rescue Hold do Chủ sở hữu kích hoạt ngay lập tức đóng băng quyền tải; (2) Cơ chế Retry Biên nhận Idempotent - không tạo biên nhận trùng, cho phép truy xuất biên nhận sau khi đã FINALIZED mà không mở lại quyền tải; (3) Quản lý đóng phòng LiveKit độc lập giữa các người nhận, chỉ xóa phòng khi LiveKit xác nhận.">
          <mxGeometry x="50" y="78" width="1600" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_beneficiary" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#EBF3EE;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#0B291E;" value="1. NGƯỜI THỤ HƯỞNG&amp;lt;br/&amp;gt;(Beneficiary)">
          <mxGeometry x="50" y="145" width="260" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_executor" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#FEF7EC;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#8C5817;" value="2. NGƯỜI THỰC THI (EXECUTOR)&amp;lt;br/&amp;gt;(Estate Executor / Verifier)">
          <mxGeometry x="310" y="145" width="260" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_frontend" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F0F4F8;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#1E3A8A;" value="3. FRONTEND REACT&amp;lt;br/&amp;gt;(Client Web App)">
          <mxGeometry x="570" y="145" width="280" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_backend" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F5F3FF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#581C87;" value="4. BACKEND ASP.NET CORE&amp;lt;br/&amp;gt;(WebApi &amp; VideoSessionService)">
          <mxGeometry x="850" y="145" width="300" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_storage" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#FDF2F8;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#831843;" value="5. DATABASE &amp; STORAGE&amp;lt;br/&amp;gt;(In-Memory Prototype / Blob)">
          <mxGeometry x="1150" y="145" width="260" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_livekit" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F0FDFA;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#134E4A;" value="6. LIVEKIT SERVER&amp;lt;br/&amp;gt;(WebRTC Cloud Server)">
          <mxGeometry x="1410" y="145" width="240" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="c_sec1_title" parent="lane_c_lane_beneficiary" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#991B1B;" value="KHỐI 1 · RESCUE HOLD KHẨN CẤP&amp;lt;br/&amp;gt;(Chủ sở hữu báo còn sống / Có tranh chấp)">
          <mxGeometry x="10" y="60" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_owner_trigger_hold" parent="lane_c_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="01 · Owner kích hoạt Emergency Hold&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;POST /api/video-sessions/{id}/emergency-hold&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="130" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c_be_lock_hold" parent="lane_c_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontFamily=Arial;fontStyle=1;fontColor=#991B1B;" value="02 · Khóa toàn bộ tiến trình bàn giao&amp;lt;br/&amp;gt;• Grant.Status = SUSPENDED_RESCUE_HOLD&amp;lt;br/&amp;gt;• Cập nhật _caseActiveHoldMap[caseId]&amp;lt;br/&amp;gt;• &amp;lt;b&amp;gt;Chặn tải file ngay lập tức (423 Locked)&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="130" width="260" height="85" as="geometry" />
