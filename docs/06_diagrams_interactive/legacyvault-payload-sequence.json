  "cards": [
    {
      "dot": "cyan",
      "title": "What is Sent (Request Payload)",
      "items": [
        "Client sends: Multipart stream of plaintext file + SHA-256 checksum calculated locally in RAM",
        "Encrypted transit: TLS 1.3 protocol protects data in-flight between Client and Server"
      ]
    },
    {
      "dot": "orange",
      "title": "What is Stored (Separation of Concerns)",
      "items": [
        "Cloudflare R2: Stores ONLY ciphertext binary blobs (.enc) with zero metadata and zero keys",
        "PostgreSQL DB: Stores non-secret metadata, Nonce 12B, Tag 16B, Checksum SHA-256, and Shamir Share 1"
      ]
    },
    {
      "dot": "emerald",
      "title": "What is Received (Response & Verification)",
      "items": [
        "Client receives: HTTP 200 containing AssetId and Shamir Share 2 for local device escrow",
        "Anti-Rogue guarantee: Server Admin holding Share 1 has exactly 0-bit information to decrypt files"
      ]
    }
  ]
