      {
        "id": "encrypt-and-store",
        "label": "2. Envelope Encrypt & Dual Storage",
        "focus": ["server", "r2", "db"],
        "note": "AES-256-GCM encryption, streaming .enc to R2, persisting metadata and Share 1 to DB."
      },
      {
        "id": "return-and-verify",
        "label": "3. Share 2 Return & Anti-Rogue Verify",
        "focus": ["server", "client", "user"],
        "note": "Client receives Share 2, confirms checksum match; server admin has 0-bit plain info."
      }
    ]
