        <mxCell id="97" parent="1" style="swimlane;startSize=28;rounded=1;arcSize=6;whiteSpace=wrap;html=1;swimlaneFillColor=#F8FAF9;strokeWidth=1.5;fontSize=12;fontStyle=1;align=left;spacingLeft=15;strokeColor=default;fontColor=default;" value="TECHNICAL SPECIFICATION CALLOUT · DATA GOVERNANCE &amp;amp; CRYPTOGRAPHIC DEFINITIONS" vertex="1">
          <mxGeometry height="145" width="1920" x="1890" y="5336" as="geometry" />
