          <mxGeometry x="50" y="20" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="desc_b" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=1;fontSize=11;fontFamily=Arial;fillColor=#F8FAFC;fontColor=#334155;strokeColor=#CBD5E1;spacingLeft=15;" value="Tuân thủ SRS v3.11.0: Kho CO_OWNED yêu cầu 100% người được chỉ định phải được xác minh và ĐỒNG Ý NHẬN trước khi cấp bất kỳ Grant nào. Một người đồng ý → Ghi nhận nhưng CHƯA CẤP GRANT. Một người từ chối hoặc hết 7 ngày → ĐÓNG BĂNG 2 NĂM SUY NGHĨ LẠI. Đủ đồng thuận trong 2 năm → Cam kết bàn giao đồng thời.">
          <mxGeometry x="50" y="78" width="1600" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lane_b_lane_beneficiary" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#EBF3EE;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#0B291E;" value="1. NGƯỜI THỤ HƯỞNG&amp;lt;br/&amp;gt;(Beneficiary)">
          <mxGeometry x="50" y="145" width="260" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_b_lane_executor" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#FEF7EC;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#8C5817;" value="2. NGƯỜI THỰC THI (EXECUTOR)&amp;lt;br/&amp;gt;(Estate Executor / Verifier)">
          <mxGeometry x="310" y="145" width="260" height="3000" as="geometry" />
        </mxCell>
        <mxCell id="lane_b_lane_frontend" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F0F4F8;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#1E3A8A;" value="3. FRONTEND REACT&amp;lt;br/&amp;gt;(Client Web App)">
