        <mxCell id="title_c" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontFamily=Arial;fontStyle=1;fillColor=#1E3A8A;fontColor=#FFFFFF;strokeColor=#0F172A;" value="TAB C · CƠ CHẾ RESCUE HOLD KHẨN CẤP, RETRY IDEMPOTENCY &amp;amp; QUẢN LÝ VÒNG ĐỜI PHÒNG LIVEKIT" vertex="1">
          <mxGeometry height="50" width="1600" x="50" y="20" as="geometry" />
        </mxCell>
        <mxCell id="desc_c" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=1;fontSize=11;fontFamily=Arial;fillColor=#F8FAFC;fontColor=#334155;strokeColor=#CBD5E1;spacingLeft=15;" value="Bao phủ 3 cơ chế an toàn trọng yếu: (1) Emergency Rescue Hold do Chủ sở hữu kích hoạt ngay lập tức đóng băng quyền tải; (2) Cơ chế Retry Biên nhận Idempotent - không tạo biên nhận trùng, cho phép truy xuất biên nhận sau khi đã FINALIZED mà không mở lại quyền tải; (3) Quản lý đóng phòng LiveKit độc lập giữa các người nhận, chỉ xóa phòng khi LiveKit xác nhận." vertex="1">
          <mxGeometry height="54" width="1600" x="50" y="78" as="geometry" />
        </mxCell>
        <mxCell id="lane_c_lane_beneficiary" parent="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#EBF3EE;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#0B291E;" value="1. NGƯỜI THỤ HƯỞNG&amp;lt;br/&amp;gt;(Beneficiary)" vertex="1">
          <mxGeometry height="3000" width="260" x="50" y="145" as="geometry" />
