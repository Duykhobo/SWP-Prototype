        </mxCell>
        <mxCell id="b_start" parent="lane_b_lane_beneficiary" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#047857;strokeWidth=2;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#FFFFFF;" value="BẮT ĐẦU&amp;lt;br/&amp;gt;Nhóm đồng thụ hưởng&amp;lt;br/&amp;gt;(Beneficiary B &amp;amp; C)">
          <mxGeometry x="30" y="60" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b_exe_verify_both" parent="lane_b_lane_executor" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="01 · Executor đối chiếu nhân thân&amp;lt;br/&amp;gt;Xác minh CCCD &amp;amp; khuôn mặt&amp;lt;br/&amp;gt;cho cả B và C qua video room">
