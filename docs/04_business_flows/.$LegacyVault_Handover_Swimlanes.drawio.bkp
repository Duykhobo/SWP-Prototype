  <diagram name="Tab A — Bàn giao một người thụ hưởng" id="tab-a-single-recipient">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_a" parent="1" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=2;fontSize=15;fontFamily=Arial;fontStyle=1;fillColor=#0B291E;fontColor=#FFFFFF;strokeColor=#051711;" value="TAB A · QUY TRÌNH BÀN GIAO DI SẢN CHO MỘT NGƯỜI THỤ HƯỞNG (SINGLE RECIPIENT HANDOVER FLOW)">
          <mxGeometry x="50" y="20" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="desc_a" parent="1" vertex="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeWidth=1;fontSize=11;fontFamily=Arial;fillColor=#F8FAFC;fontColor=#334155;strokeColor=#CBD5E1;spacingLeft=15;" value="Kiến trúc luồng bàn giao khép kín cho kho 1 người (SINGLE_RECIPIENT): Mời qua link khách giới hạn → Đối chiếu nhân thân video call → Executor xác nhận quyền → Beneficiary duyệt điều khoản &amp; nhận → Sinh Grant &amp; DownloadToken độc lập → Tải bản mã &amp; log server → Ký biên nhận điện tử (gắn mã băm chữ ký &amp; nội dung) → Finalize &amp; thu hồi phiên khách → Đóng phòng LiveKit khi xác nhận.">
          <mxGeometry x="50" y="78" width="1600" height="54" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_beneficiary" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#EBF3EE;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#0B291E;" value="1. NGƯỜI THỤ HƯỞNG&amp;lt;br/&amp;gt;(Beneficiary)">
          <mxGeometry x="50" y="145" width="260" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_executor" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#FEF7EC;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#8C5817;" value="2. NGƯỜI THỰC THI (EXECUTOR)&amp;lt;br/&amp;gt;(Estate Executor / Verifier)">
          <mxGeometry x="310" y="145" width="260" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_frontend" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F0F4F8;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#1E3A8A;" value="3. FRONTEND REACT&amp;lt;br/&amp;gt;(Client Web App)">
          <mxGeometry x="570" y="145" width="280" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_backend" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F5F3FF;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#581C87;" value="4. BACKEND ASP.NET CORE&amp;lt;br/&amp;gt;(WebApi &amp; VideoSessionService)">
          <mxGeometry x="850" y="145" width="300" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_storage" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#FDF2F8;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#831843;" value="5. DATABASE &amp; STORAGE&amp;lt;br/&amp;gt;(In-Memory Prototype / Blob)">
          <mxGeometry x="1150" y="145" width="260" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="lane_a_lane_livekit" parent="1" vertex="1" style="swimlane;horizontal=1;startSize=40;rounded=0;collapsible=0;whiteSpace=wrap;html=1;swimlaneFillColor=#F0FDFA;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#FFFFFF;fillColor=#134E4A;" value="6. LIVEKIT SERVER&amp;lt;br/&amp;gt;(WebRTC Cloud Server)">
          <mxGeometry x="1410" y="145" width="240" height="3600" as="geometry" />
        </mxCell>
        <mxCell id="a_start" parent="lane_a_lane_beneficiary" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#047857;strokeWidth=2;fontSize=12;fontFamily=Arial;fontStyle=1;fontColor=#FFFFFF;" value="BẮT ĐẦU&amp;lt;br/&amp;gt;Mở link mời nhận di sản&amp;lt;br/&amp;gt;(?token=guest_tok_...)">
          <mxGeometry x="30" y="60" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_call_validate" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="01 · Gửi yêu cầu xác thực phiên&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;GET /api/video-sessions/guest-link&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Params: { token: guestToken }">
          <mxGeometry x="20" y="60" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_be_validate" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="02 · ValidateGuestSessionAsync&amp;lt;br/&amp;gt;• Kiểm tra token, TTL, Status==ACTIVE&amp;lt;br/&amp;gt;• Kiểm tra Case: APPROVED_FOR_DELIVERY&amp;lt;br/&amp;gt;• Kiểm tra Time-lock == 0 &amp;amp; Rescue Hold">
          <mxGeometry x="20" y="60" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_dec_valid" parent="lane_a_lane_backend" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontFamily=Arial;fontStyle=1;fontColor=#92400E;" value="Token &amp;amp; Case&amp;lt;br/&amp;gt;hợp lệ?">
          <mxGeometry x="80" y="170" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_reject_token" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#991B1B;" value="Hiển thị thông báo lỗi&amp;lt;br/&amp;gt;401 / 403 / 423 Locked&amp;lt;br/&amp;gt;Từ chối truy cập phòng">
          <mxGeometry x="20" y="175" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_end_rejected" parent="lane_a_lane_beneficiary" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EF4444;strokeColor=#B91C1C;strokeWidth=2;fontSize=11;fontFamily=Arial;fontStyle=1;fontColor=#FFFFFF;" value="KẾT THÚC&amp;lt;br/&amp;gt;Phiên bị từ chối">
          <mxGeometry x="40" y="175" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_prejoin" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="03 · Render Pre-join Desk&amp;lt;br/&amp;gt;• Kiểm tra Camera / Micro cục bộ&amp;lt;br/&amp;gt;• Hiển thị thông tin hồ sơ di sản&amp;lt;br/&amp;gt;(Chưa có nội dung file &amp;amp; khóa)">
          <mxGeometry x="20" y="285" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_ben_join" parent="lane_a_lane_beneficiary" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="04 · Bấm 'Vào phòng xác minh'&amp;lt;br/&amp;gt;Xác nhận kết nối video với Executor">
          <mxGeometry x="30" y="290" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_get_room_token" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="05 · Xin token phòng LiveKit&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;POST /api/video-sessions/{id}/join-token&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Kèm GuestToken xác thực">
          <mxGeometry x="20" y="395" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_be_issue_room_token" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="06 · Sinh LiveKit Room Token&amp;lt;br/&amp;gt;Gán Identity = BeneficiaryId,&amp;lt;br/&amp;gt;Claim: role=GUEST_BENEFICIARY">
          <mxGeometry x="20" y="395" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_lk_connect_ben" parent="lane_a_lane_livekit" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="07 · LiveKit Room Connect&amp;lt;br/&amp;gt;Beneficiary gia nhập phòng;&amp;lt;br/&amp;gt;Publish Audio/Video tracks">
          <mxGeometry x="20" y="395" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_exe_login" parent="lane_a_lane_executor" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="08 · Executor đăng nhập JWT&amp;lt;br/&amp;gt;Được kiểm tra đúng quyền phân công&amp;lt;br/&amp;gt;vào phòng xác minh">
          <mxGeometry x="30" y="500" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_be_check_exe" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="09 · Đối chiếu phân công Executor&amp;lt;br/&amp;gt;Khớp AssignedVerifierId / AssignedExecutorId.&amp;lt;br/&amp;gt;Chặn beneficiary đóng giả Executor!">
          <mxGeometry x="20" y="500" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_lk_connect_exe" parent="lane_a_lane_livekit" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="10 · Thiết lập P2P Video Mesh&amp;lt;br/&amp;gt;Kênh WebRTC trực tiếp hai chiều&amp;lt;br/&amp;gt;giữa Executor và Beneficiary">
          <mxGeometry x="20" y="590" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_exe_eval" parent="lane_a_lane_executor" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="11 · Đối chiếu CCCD &amp;amp; Khuôn mặt&amp;lt;br/&amp;gt;Thực hiện challenge tương tác trực tiếp;&amp;lt;br/&amp;gt;Loại trừ nguy cơ Deepfake">
          <mxGeometry x="30" y="680" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_dec_id_match" parent="lane_a_lane_executor" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontFamily=Arial;fontStyle=1;fontColor=#92400E;" value="Nhân thân&amp;lt;br/&amp;gt;chính xác?">
          <mxGeometry x="60" y="780" width="140" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_exe_reject" parent="lane_a_lane_executor" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#991B1B;" value="Từ chối xác minh / Yêu cầu bổ sung&amp;lt;br/&amp;gt;Ghi chú lý do nghi vấn">
          <mxGeometry x="30" y="890" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_exe_allow" parent="lane_a_lane_executor" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;fontFamily=Arial;fontStyle=1;fontColor=#166534;" value="12 · Bấm 'Xác nhận nhân thân &amp;amp;&amp;lt;br/&amp;gt;Cho phép nhận di sản'&amp;lt;br/&amp;gt;trên giao diện Executor">
          <mxGeometry x="30" y="980" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_send_allow" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="13 · Gửi lệnh phê chuẩn nhân thân&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;POST /api/case-bundles/{id}/executor-allow&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Headers: { Authorization: Bearer JWT }">
          <mxGeometry x="20" y="980" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_be_save_allow" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="14 · AuthorizeRecipientByExecutorAsync&amp;lt;br/&amp;gt;• Đánh dấu session.EvaluatedAt&amp;lt;br/&amp;gt;• Set gs.IsExecutorAuthorized = true&amp;lt;br/&amp;gt;• &amp;lt;b&amp;gt;KHÔNG tự mở Time-lock/Duyệt Case&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="980" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_render_handover" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="15 · Kích hoạt Bảng Bàn Giao Di Sản&amp;lt;br/&amp;gt;Hiển thị điều khoản pháp lý, ô cam kết&amp;lt;br/&amp;gt;và nút 'Chấp nhận nhận di sản'">
          <mxGeometry x="20" y="1090" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_ben_accept" parent="lane_a_lane_beneficiary" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="16 · Bấm 'Đồng ý nhận di sản'&amp;lt;br/&amp;gt;Đọc điều khoản, tick cam kết trách nhiệm&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;Kèm Passkey FIDO2 [MÔ PHỎNG]&amp;lt;/i&amp;gt;">
          <mxGeometry x="30" y="1180" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_send_accept" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="17 · Gửi quyết định nhận di sản&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;POST /api/video-sessions/{id}/accept-handover&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Payload: { legalAck: true, secondFactorProof: ... }">
          <mxGeometry x="20" y="1180" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_be_accept" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="18 · AcceptHandoverAsync (Atomic)&amp;lt;br/&amp;gt;• Kiểm tra IsExecutorAuthorized == true&amp;lt;br/&amp;gt;• Kiểm tra Rescue Hold == false &amp;amp; TimeLock == 0&amp;lt;br/&amp;gt;• Ghi nhận Decision = ACCEPT&amp;lt;br/&amp;gt;• Tạo HANDOVER_COMMITTED">
          <mxGeometry x="20" y="1180" width="260" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a_be_create_grant" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="19 · Cấp AccessGrant &amp;amp; DownloadToken&amp;lt;br/&amp;gt;• Status = ACTIVE (Hạn 7 ngày)&amp;lt;br/&amp;gt;• Sinh DownloadToken ngẫu nhiên bảo mật&amp;lt;br/&amp;gt;• Gán đúng BeneficiaryId &amp;amp; BundleId">
          <mxGeometry x="20" y="1300" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_store_grant" parent="lane_a_lane_storage" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BE185D;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;strokeDasharray=3 3;" value="20 · Lưu trữ AccessGrant&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;[MÔ PHỎNG IN-MEMORY]&amp;lt;/i&amp;gt;&amp;lt;br/&amp;gt;Lưu vào _grants &amp;amp; _grantsByDownloadToken&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;(Chưa lưu Database bền vững)&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="1300" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_render_files" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="21 · Hiển thị Danh Sách Tệp Di Sản&amp;lt;br/&amp;gt;Gắn DownloadToken vào nút tải từng tệp;&amp;lt;br/&amp;gt;Đánh dấu tệp Bắt Buộc (Mandatory)">
          <mxGeometry x="20" y="1410" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_ben_download_click" parent="lane_a_lane_beneficiary" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="22 · Bấm 'Giải mã &amp;amp; Tải về'&amp;lt;br/&amp;gt;Tải từng tệp di sản bản mã">
          <mxGeometry x="30" y="1510" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_req_download" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="23 · Yêu cầu tải bản mã qua HTTPS&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;GET /api/case-bundles/{id}/assets/{assetId}/download&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Params: { downloadToken: ... }">
          <mxGeometry x="20" y="1510" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a_be_serve_asset" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="24 · VerifyAndServeEncryptedAssetAsync&amp;lt;br/&amp;gt;• Kiểm tra DownloadToken &amp;amp; Grant Status==ACTIVE&amp;lt;br/&amp;gt;• Kiểm tra TTL (7 ngày) &amp;amp; Rescue Hold&amp;lt;br/&amp;gt;• Kiểm tra Asset thuộc Manifest kho di sản&amp;lt;br/&amp;gt;• &amp;lt;b&amp;gt;Ghi Server Log: _verifiedAssetDownloads&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="1510" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_decrypt_mock" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#92400E;strokeDasharray=3 3;" value="25 · Xử lý tải về thiết bị&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;[MÔ PHỎNG GIẢI MÃ RAM PROTOTYPE]&amp;lt;/i&amp;gt;&amp;lt;br/&amp;gt;Tạo Blob URL từ bản mã tải về&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;(Chưa chạy WebCrypto AES-GCM thật)&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="1640" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_ben_sign_canvas" parent="lane_a_lane_beneficiary" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="26 · Ký tay trên Canvas&amp;lt;br/&amp;gt;Ký xác nhận đã mở &amp;amp; lưu đủ tệp bắt buộc;&amp;lt;br/&amp;gt;Tick xác nhận nội dung biên nhận">
          <mxGeometry x="30" y="1750" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_fe_send_finalize" parent="lane_a_lane_frontend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="27 · Gửi yêu cầu hoàn tất biên nhận&amp;lt;br/&amp;gt;&amp;lt;b&amp;gt;POST /api/case-bundles/{id}/finalize&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;Payload: { clientConfirmedAssetIds, sigData: data:image/png;base64... }">
          <mxGeometry x="20" y="1750" width="240" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a_be_finalize" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="28 · FinalizeHandoverSessionAsync&amp;lt;br/&amp;gt;• Bước 0: Kiểm tra Idempotency Retry&amp;lt;br/&amp;gt;• Kiểm tra chữ ký: format base64, size &amp;amp;lt;= 512KB&amp;lt;br/&amp;gt;• Đối soát đủ tệp: Server log == Client confirm&amp;lt;br/&amp;gt;• &amp;lt;b&amp;gt;SignatureHash = SHA256(sigData)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;• &amp;lt;b&amp;gt;ReceiptContentHash = SHA256(canonical)&amp;lt;/b&amp;gt;">
          <mxGeometry x="20" y="1750" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="a_be_close_session" parent="lane_a_lane_backend" vertex="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontFamily=Arial;fontColor=#1E293B;" value="29 · Cập nhật trạng thái bảo mật&amp;lt;br/&amp;gt;• Grant.Status = FINALIZED (Đóng quyền tải)&amp;lt;br/&amp;gt;• GuestSession.Status = COMPLETED (Thu hồi)&amp;lt;br/&amp;gt;• Session.Status = COMPLETED">
